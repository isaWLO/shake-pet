{
  "name": "shake-pet",
  "version": "0.2.0",
  "private": true,
  "author": "isaWLO",
  "description": "A transparent desktop and web shake-toy widget",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "web": "node scripts/serve-web.js",
    "test": "node tests/world-layout.test.js && node tests/capture-region.test.js && node tests/ai-model.test.js && node tests/ai-cutout.test.js && node tests/container-mask.test.js",
    "build:web": "node scripts/build-web.js",
    "dist:mac": "electron-builder --mac dmg"
  },
  "dependencies": {
    "matter-js": "^0.20.0",
    "onnxruntime-web": "^1.29.0"
  },
  "devDependencies": {
    "electron": "^37.2.3",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.isawlo.shakepet",
    "productName": "Shake Pet",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "web-bridge.js",
      "world-layout.js",
      "ai-model.js",
      "ai-cutout.js",
      "capture-region.js",
      "capture.html",
      "container-mask.js",
      "custom-container.html",
      "custom-container.js",
      "index.html",
      "unlock.html",
      "styles.css",
      "assets/containers/**/*",
      "package.json",
      "node_modules/matter-js/**/*",
      "node_modules/onnxruntime-web/dist/ort.wasm.min.js",
      "node_modules/onnxruntime-web/dist/ort-wasm-simd-threaded.mjs",
      "node_modules/onnxruntime-web/dist/ort-wasm-simd-threaded.wasm"
    ],
    "mac": {
      "category": "public.app-category.entertainment",
      "target": [
        "dmg"
      ],
      "extendInfo": {
        "NSAudioCaptureUsageDescription": "Shake Pet analyzes system audio locally to animate your pictures.",
        "NSMicrophoneUsageDescription": "Shake Pet can use microphone audio when system audio capture is unavailable.",
        "NSScreenCaptureUsageDescription": "Shake Pet needs screen capture permission only to access shared system audio."
      }
    },
    "dmg": {
      "artifactName": "Shake-Pet-${version}-${arch}.${ext}"
    }
  }
}
